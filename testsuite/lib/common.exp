# Extract the expected output from special comments prefixed with
# "cp-out" within the source code file.
# A line spanning comment containing only "cp-xfail" marks the test
# as expected to fail.
# Comments prefixed with "cp-include-dir" specify include directories,
# relative to the source code file's directory.
proc get_expected_result {filename} {
    set fp [open "$filename"]

    set expected_msgs [list]
    set is_xfailer 0
    set include_dirs [list]
    while {[gets $fp line] >= 0} {
	if {[regexp {(?:\s*/\*)(?:\s*)(?:cp-out:\s*)(.+[^\s])(?:\s*\*/)(?:\s*)} $line -> m]} {
	    lappend expected_msgs "$m"
	} elseif {[regexp {(?:\s*/\*)(?:\s*)(?:cp-xfail)(?:\s*\*/)(?:\s*)} $line]} {
	    set is_xfailer 1
	} elseif {[regexp {(?:\s*/\*)(?:\s*)(?:cp-include-dir:\s*)(.+[^\s])(?:\s*\*/)(?:\s*)} $line -> d]} {
	    lappend include_dirs "[file dirname $filename]/$d"
	}
    }

    close $fp
    return [list $expected_msgs $is_xfailer $include_dirs]
}

proc do_fail {is_xfailer msg} {
    if $is_xfailer {
	xfail "$msg"
    } else {
	fail "$msg"
    }
}

proc do_pass {is_xfailer msg} {
    if $is_xfailer {
	xpass "$msg"
    } else {
	pass "$msg"
    }
}
